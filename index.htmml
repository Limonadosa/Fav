<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Minha galeria</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 1000px;
      margin: 30px auto;
      padding: 0 20px;
      background: #f2f2f2;
    }

    h1, h2 {
      text-align: center;
    }

    .galeria {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }

    .item {
      background: white;
      padding: 15px;
      border-radius: 8px;
      box-shadow: 0 2px 6px #0002;
    }

    .item img,
    .item iframe {
      display: block;
      width: 100%;
      border: 0;
      border-radius: 5px;
    }

    .item iframe {
      aspect-ratio: 16 / 9;
    }

    .item p {
      margin-bottom: 0;
      text-align: center;
    }
  </style>
</head>

<body>

  <h1>Minha galeria</h1>

  <h2>Imagens e vídeos</h2>

  <div class="galeria">

    <!-- IMAGEM 1 -->
    <div class="item">
      <img
        src="COLE_AQUI_O_LINK_DIRETO_DA_IMAGEM"
        alt="Descrição da imagem">

      <p>Imagem 1</p>
    </div>

    <!-- IMAGEM 2 -->
    <div class="item">
      <img
        src="COLE_AQUI_O_LINK_DIRETO_DA_IMAGEM"
        alt="Descrição da imagem">

      <p>Imagem 2</p>
    </div>

    <!-- VÍDEO 1 -->
    <div class="item">
      <iframe
        src="https://ahrimp4.rule34.xxx//images/6236/1a67d960b02541b599695e136bb9d3bb.mp4?7096817"
        title="Vídeo 1"
        allowfullscreen>
      </iframe>

      <p>Vídeo 1</p>
    </div>

    <!-- VÍDEO 2 -->
    <div class="item">
      <iframe
        src="COLE_AQUI_O_SOURCE_DO_VIDEO"
        title="Vídeo 2"
        allowfullscreen>
      </iframe>

      <p>Vídeo 2</p>
    </div>

  </div>

</body>
</html>
